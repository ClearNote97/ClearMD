# =============================================================================
# ClearMD - .gitignore
# =============================================================================

# --- ENTORNO ---
.env

# --- PYTHON ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
*.egg-info/
dist/
build/

# --- UV ---
# uv.lock SÍ se versiona (builds reproducibles) → NO se ignora, a propósito.
# (En .gitignore los comentarios van en su propia línea; un "#" al final de un
#  patrón se toma como parte del patrón y lo rompe.)

# --- SALIDAS DE CLEARMD ---
# Carpetas que la app genera al convertir (p. ej. al probar a mano sobre tests/fixtures).
ClearMD_Output/

# --- HERRAMIENTAS ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- SISTEMA OPERATIVO ---
.DS_Store
Thumbs.db

# --- IDEs ---
.idea/
*.swp
*.swo

# --- LOGS ---
*.log
logs/