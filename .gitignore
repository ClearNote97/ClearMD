# =============================================================================
# ClearMD - .gitignore
# =============================================================================

# --- ENVIRONMENT ---
.env

# --- PYTHON ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
*.egg-info/
dist/
build/

# --- UV ---
# uv.lock IS committed (reproducible builds) -> deliberately not ignored.
# (Comments in .gitignore go on their own line; a trailing "#" becomes part of the pattern.)

# --- CLEARMD OUTPUTS ---
# Folders the app creates when converting (e.g. when trying it by hand on tests/fixtures).
ClearMD_Output/

# --- TOOLS ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- OPERATING SYSTEM ---
.DS_Store
Thumbs.db

# --- IDEs ---
.idea/
*.swp
*.swo

# --- LOGS ---
*.log
logs/