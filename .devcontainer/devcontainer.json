{
  // Name shown in the Dev Containers list. Resolved when opening.
  "name": "${localWorkspaceFolderBasename}",

  // Orchestration: the docker-compose.yml at the repo root
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app-dev",

  // initializeCommand (HOST, before start-up): ties APP_NAME to the folder name so the mount
  // (${APP_NAME}) and workspaceFolder (${localWorkspaceFolderBasename}) NEVER diverge.
  // Creates .env from the example if missing. Needs a POSIX shell on the host (WSL/Linux/macOS).
  "initializeCommand": "bash -lc 'cp -n .env.example .env 2>/dev/null || true; d=$(basename \"$PWD\"); sed -i -E \"s|^APP_NAME=[^#]*|APP_NAME=$d  |\" .env 2>/dev/null || true'",

  // runServices: the only development service (ClearMD has no database, ADR-0002).
  "runServices": ["app-dev"],

  // When VS Code closes, stop the compose project (do not remove it)
  "shutdownAction": "stopCompose",

  // ------------------------------------------------------------
  // IMPORTANT: no "workspaceMount" here.
  // - The code mount is defined in docker-compose.yml (recommended).
  // - workspaceMount plus a compose volume conflicts on Windows.
  // ------------------------------------------------------------

  // Path inside the container where VS Code opens the folder.
  // Must match the working_dir / volume defined in docker-compose.yml.
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "customizations": {
    "vscode": {
      // ------------------------------------------------------------
      // Editor settings (adjust to taste)
      // ------------------------------------------------------------
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        // Python interpreter expected inside the mounted workspace
        "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.inlayHints.variableTypes": true,
        "python.analysis.inlayHints.functionReturnTypes": true,
        "editor.wordWrap": "on",
        "workbench.iconTheme": "material-icon-theme"
      },

      // ------------------------------------------------------------
      // Recommended extensions / explicit dependencies
      // ------------------------------------------------------------
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",            // required by ms-python
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "christian-kohler.path-intellisense",
        "pkief.material-icon-theme",
        "sst-dev.opencode"
      ]
    }
  },

  // Non-root user created in the Dockerfile with the host user's UID/GID, so files written in the
  // bind mount (git objects, .venv, test outputs) belong to the host user. On Linux/WSL VS Code also
  // aligns the UID automatically if the host user is not 1000.
  "remoteUser": "dev",
  "updateRemoteUserUID": true,

  // ------------------------------------------------------------
  // postCreateCommand: init.sh installs the dependencies with uv (reproducible uv.lock).
  // Development only (APP_ENV).
  // ------------------------------------------------------------
  "postCreateCommand": "bash init.sh"
}