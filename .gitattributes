# Line-ending normalization: LF for all text.
# Keeps CRLF files from breaking `source .env`, .sh scripts, etc.
* text=auto eol=lf

# Explicit (what a shell or Python runs or parses) — ALWAYS LF
*.sh          text eol=lf
*.sql         text eol=lf
*.py          text eol=lf
*.env         text eol=lf
.env          text eol=lf
.env.example  text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
Dockerfile    text eol=lf
*.json        text eol=lf

# Binaries (leave untouched)
*.png binary
*.jpg binary
*.parquet binary
*.xlsx binary
