<style:style style:name="Neg" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
<style:style style:name="Ita" style:family="text"><style:text-properties fo:font-style="italic"/></style:style>
<style:style style:name="Sub" style:family="text"><style:text-properties style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/></style:style>
