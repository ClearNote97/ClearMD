# =============================================================================
# ClearMD — Development environment variables (.env.example)
# =============================================================================
# The devcontainer initializeCommand copies this file to .env (if missing) and
# sets APP_NAME to the folder name. .env is never committed.
# ClearMD needs no database and no secrets (ADR-0002, ADR-0005).
# =============================================================================

# --- ENVIRONMENT ---
# 'development' (default). init.sh refuses to run with 'prod'/'production'.
APP_ENV=development
APP_NAME=clearmd                # <--- Overwritten by the initializeCommand
LOG_LEVEL=INFO
