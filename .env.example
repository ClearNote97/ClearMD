# =============================================================================
# ClearMD — Variables de entorno de desarrollo (.env.example)
# =============================================================================
# El initializeCommand del devcontainer copia este archivo a .env (si no existe)
# y fija APP_NAME con el nombre de la carpeta. .env nunca se versiona.
# ClearMD no usa base de datos ni secretos (ADR-0002, ADR-0005).
# =============================================================================

# --- ENTORNO ---
# 'development' (default). init.sh se niega a correr con 'prod'/'production'.
APP_ENV=development
APP_NAME=clearmd                # <--- Lo sobrescribe el initializeCommand
LOG_LEVEL=INFO
